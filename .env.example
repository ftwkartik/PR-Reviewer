APP_ENV=development
DATABASE_URL=postgresql+asyncpg://review:review@postgres:5432/review
REDIS_URL=redis://redis:6379/0

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local inference (no paid API): LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5-coder:3b (run `ollama pull <model>`).
# Host-side runs use localhost; docker-compose overrides this to host.docker.internal for containers.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama truncates prompts past num_ctx, so the app budgets to it (MAX_CONTEXT_TOKENS is capped by it).
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
VOYAGE_API_KEY=

API_KEY=
REVIEW_CONFIDENCE_THRESHOLD=0.75
MAX_CHANGED_LINES=3000
MAX_FILES_PER_REVIEW=60
MAX_CONTEXT_TOKENS=24000
MAX_MODEL_CALLS=12

RATE_LIMIT_PER_MINUTE=60
ALLOWED_OWNERS=
DAILY_BUDGET_USD=0
FINDINGS_RETENTION_DAYS=90
METRICS_TOKEN=
WORKER_METRICS_PORT=9102
STATIC_ANALYZERS=ruff,bandit,semgrep
